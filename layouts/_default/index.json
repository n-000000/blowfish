{{- $index := slice -}}
{{ $pages := .Site.Pages }}
{{ range .Site.Home.Translations }}
{{ $pages = $pages | lang.Merge .Site.Pages }}
{{ end }}
{{- range $pages -}}
  {{- /* musictide: search surface is articles + category terms only. Excludes
       home, section nodes, the taxonomy list, and tag/author/ad/event pages.
       Only the title is indexed (search.js matches title; for category terms
       the title is the category name). To make events searchable once that
       section is wired, add: (eq .Section "events") to $isArticle below. */ -}}
  {{- $isArticle := and (eq .Kind "page") (eq .Section "posts") -}}
  {{- $isCategory := and (eq .Kind "term") (eq .Type "categories") -}}
  {{- if and (or $isArticle $isCategory) (not .Params.excludeFromSearch) -}}
    {{- $section := .Site.GetPage "section" .Section -}}
    {{- if .Date -}}
      {{- $index = $index | append (dict
      "date" (.Date | time.Format (.Site.Language.Params.dateFormat | default ":date_long"))
      "title" (.Title | emojify | safeJS)
      "section" ($section.Title | emojify | safeJS)
      "permalink" .RelPermalink
      "externalUrl" .Params.externalUrl
      "type" .Type
      ) -}}
    {{- else -}}
      {{- $index = $index | append (dict
      "title" (.Title | emojify | safeJS)
      "section" ($section.Title | emojify | safeJS)
      "permalink" .RelPermalink
      "externalUrl" .Params.externalUrl
      "type" .Type
      ) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $index | jsonify -}}